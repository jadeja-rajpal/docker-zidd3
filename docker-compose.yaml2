services:

  dashboard:
    build: .
    container_name: devops-dashboard
    ports:
      - "3000:3000"
    volumes:
      - dashboard-data:/app/data
    depends_on:
      - redis
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: redis
    restart: unless-stopped


volumes:
  dashboard-data:
